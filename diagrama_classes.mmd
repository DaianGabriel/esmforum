classDiagram

class Usuario {
    +int id_usuario
    +string nome
}

class Pergunta {
    +int id_pergunta
    +string texto
    +int id_usuario
    +cadastrar()
    +buscar()
}

class Resposta {
    +int id_resposta
    +int id_pergunta
    +string texto
    +cadastrar()
}

class Tag {
    +int id_tag
    +string nome
}

class Voto {
    +int id_voto
    +int valor
}

Usuario "1" --> "0..*" Pergunta : cria
Usuario "1" --> "0..*" Voto : realiza

Pergunta "1" --> "0..*" Resposta : possui
Pergunta "1" --> "0..*" Voto : recebe

Pergunta "0..*" -- "0..*" Tag : possui
